---
import { getCollection } from 'astro:content'
import Layout from '~/layouts/Layout.astro'
import '~/styles/index.scss'
import BlogList from '~/components/BlogList.astro'

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const postMap = new Map(posts.map(post => [post.id, post]))
const formatPosts = posts.map(post => ({
	...post,
	re: post.data.re ? postMap.get(post.data.re) : null
}))
---

<Layout title={'InvisyArcticFox\'s Blog'}>
	<div class='head'>
		<div class='top'>InvisyArcticFox's Blog</div>
		<div class='desc'>For when I just want to write about something!</div>
	</div>

	<BlogList posts={formatPosts} />
</Layout>
